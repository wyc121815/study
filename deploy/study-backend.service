[Unit]
Description=Study Backend (Spring Boot)
Documentation=https://github.com/wyc121815/study
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=study
Group=study
WorkingDirectory=/srv/study/current

# -Xmx 限制堆内存，2G 内存的机器上留出余量给 Nginx 和系统
ExecStart=/usr/bin/java -Xms128m -Xmx512m -XX:+UseSerialGC \
    -jar /srv/study/current/backend.jar \
    --server.address=127.0.0.1

# systemd 停止时发送 SIGTERM，Spring Boot 优雅退出，退出码 143 视为正常
SuccessExitStatus=143
KillSignal=SIGTERM
TimeoutStopSec=30

Restart=always
RestartSec=5

# 日志走 journald，同时可用 journalctl -u study-backend 查看
StandardOutput=journal
StandardError=journal
SyslogIdentifier=study-backend

# 基础加固
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true

[Install]
WantedBy=multi-user.target
